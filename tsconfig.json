{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "svelte"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.svelte",
    "examples/**/*.ts",
    "examples/**/*.svelte"
  ],
  "exclude": [
    "node_modules"
  ]
}

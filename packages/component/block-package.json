{
  "format": 1,
  "name": "@mywinkel/block-component",
  "version": "0.1.2",
  "sdkVersion": "0.1",
  "blocks": [
    {
      "id": "component",
      "label": "Site component",
      "description": "Site component block",
      "configuration": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "heading": {
            "default": "",
            "type": "string",
            "maxLength": 500
          },
          "componentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "configuration": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 50000
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        },
        "required": [
          "heading",
          "configuration"
        ],
        "additionalProperties": false
      },
      "fields": [
        {
          "key": "heading",
          "label": "Heading",
          "type": "text"
        }
      ],
      "parts": {
        "block.root": "min-w-0 wrap-anywhere data-[cms-block]:relative data-[cms-block]:outline-offset-8 data-[cms-block]:hover:outline data-[cms-block]:hover:outline-dashed data-[cms-block]:hover:outline-ring data-[cms-selected]:outline-2 data-[cms-selected]:outline-ring",
        "block.heading": "mb-6 text-3xl font-medium",
        "component.root": "min-w-0",
        "component.heading": "mb-6 text-3xl font-medium"
      },
      "interactive": false,
      "children": false,
      "viewMode": "block"
    }
  ],
  "entries": {
    "server": "dist/server.js",
    "browser": "dist/browser.js",
    "settings": "dist/settings.js"
  },
  "migrations": []
}
